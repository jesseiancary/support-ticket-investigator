# Copy to .env and fill in. .env is gitignored — never commit secrets.

# --- OpenAI (used from Phase 2 onward; not required to pass Phase 1 tests) ---
OPENAI_API_KEY=sk-your-key-here

# --- Database (Postgres + pgvector) ---
# Used by the api service inside the compose network (host "db").
POSTGRES_USER=sti
POSTGRES_PASSWORD=sti
POSTGRES_DB=sti
DATABASE_URL=postgres://sti:sti@db:5432/sti

# --- Host port mappings (override if a port is already in use) ---
DB_PORT=5432
API_PORT=3000
WEB_PORT=5173

# --- Runtime ---
NODE_ENV=development
